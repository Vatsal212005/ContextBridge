CONTEXTBRIDGE_NAME=ContextBridge
CONTEXTBRIDGE_ENV=development
CONTEXTBRIDGE_LOG_LEVEL=INFO
CONTEXTBRIDGE_TRANSPORT=stdio
CONTEXTBRIDGE_HOST=127.0.0.1
CONTEXTBRIDGE_PORT=8000

# GitHub fine-grained PAT. Keep this blank in source control.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_TIMEOUT_SECONDS=20
GITHUB_MAX_RETRIES=3

# Local SQLite telemetry database. Relative paths resolve from the project root.
CONTEXTBRIDGE_DB_PATH=data/contextbridge.db

# Mutation safety. 6B is intentionally skipped; v0.8 remains dry-run by default.
CONTEXTBRIDGE_DRY_RUN=true
GITHUB_WRITES_ENABLED=false
# Comma-separated owner/repo allowlist for future live issue writes. Empty = none.
GITHUB_WRITE_REPOSITORIES=

# Pending actions expire if not executed within this many minutes.
CONTEXTBRIDGE_CONFIRMATION_TTL_MINUTES=30

# Local React control plane. Keep localhost unless you intentionally configure a token.
CONTEXTBRIDGE_DASHBOARD_HOST=127.0.0.1
CONTEXTBRIDGE_DASHBOARD_PORT=8765
# Required automatically by the server if you bind the dashboard to a non-loopback address.
CONTEXTBRIDGE_DASHBOARD_TOKEN=

# Integrated dashboard chat. API keys remain server-side.
CONTEXTBRIDGE_LLM_PROVIDER=gemini
CONTEXTBRIDGE_LLM_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
# Optional OpenAI provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
# Optional local-provider alternative: set provider=ollama and choose an installed model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
CONTEXTBRIDGE_LLM_TIMEOUT_SECONDS=120
CONTEXTBRIDGE_CHAT_MAX_TOOL_ROUNDS=8
CONTEXTBRIDGE_CHAT_HISTORY_MESSAGES=30
CONTEXTBRIDGE_CHAT_READ_ONLY_DEFAULT=true
